+
+/**
+ * Delegating {@link SSLSocket} wrapper that enforces a custom TLS SNI hostname
+ * before the TLS handshake begins, preventing HTTP clients (e.g. OkHttp Platform
+ * or Android HttpsURLConnection) from overwriting the SNI with the original host.
+ */
+public class CustomSniSSLSocket extends SSLSocket {
+    private static final String TAG = CustomSniSSLSocket.class.getSimpleName();
+
+    private final SSLSocket mDelegate;
+    private final String mCustomSni;
+    private final int mHandshakeTimeoutMs;
+
+    public CustomSniSSLSocket(SSLSocket delegate, String customSni) {
+        this(delegate, customSni, 0);
+    }
+
+    public CustomSniSSLSocket(SSLSocket delegate, String customSni, int handshakeTimeoutMs) {
+        mDelegate = delegate;
+        mCustomSni = customSni;
+        mHandshakeTimeoutMs = handshakeTimeoutMs;
+        applyCustomSni();
+    }
+
+    private void applyCustomSni() {
+        if (mCustomSni == null || mCustomSni.isEmpty()) {
+            return;
+        }
+
+        boolean applied = false;
+
+        // 1. Standard Java 8+ / Android API 24+ SNI via SSLParameters
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N || Build.VERSION.SDK_INT == 0) {
+            try {
+                SSLParameters params = mDelegate.getSSLParameters();
+                if (params != null) {
+                    params.setServerNames(Collections.<SNIServerName>singletonList(new SNIHostName(mCustomSni)));
+                    mDelegate.setSSLParameters(params);
+                    applied = true;
+                }
+            } catch (Throwable ignored) {
+                // Fall through to reflection-based SNI configuration
+            }
+        }
+
+        // 2. Android / Conscrypt SSLSocket setHostname(String) reflection
+        try {
+            Method setUseSessionTickets = mDelegate.getClass().getMethod("setUseSessionTickets", boolean.class);
+            setUseSessionTickets.invoke(mDelegate, true);
+        } catch (Throwable ignored) {
+        }
+
+        try {
+            Method setHostname = mDelegate.getClass().getMethod("setHostname", String.class);
+            setHostname.invoke(mDelegate, mCustomSni);
+            applied = true;
+        } catch (Throwable ignored) {
+        }
+
+        if (!applied) {
+            Log.w(TAG, "Unable to explicitly set custom SNI '%s' on socket %s",
+                    mCustomSni, mDelegate.getClass().getName());
+        }
+    }
+
+    @Override
+    public void setSSLParameters(SSLParameters params) {
+        if (params != null && mCustomSni != null && !mCustomSni.isEmpty()
+                && (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N || Build.VERSION.SDK_INT == 0)) {
+            try {
+                params.setServerNames(Collections.<SNIServerName>singletonList(new SNIHostName(mCustomSni)));
+            } catch (Throwable ignored) {
+            }
+        }
+        mDelegate.setSSLParameters(params);
+    }
+
+    @Override
+    public SSLParameters getSSLParameters() {
+        return mDelegate.getSSLParameters();
+    }
+
+    @Override
+    public void startHandshake() throws IOException {
+        applyCustomSni();
+        if (mHandshakeTimeoutMs > 0) {
+            int previousTimeout = mDelegate.getSoTimeout();
+            mDelegate.setSoTimeout(mHandshakeTimeoutMs);
+            try {
+                mDelegate.startHandshake();
+            } finally {
+                try {
+                    mDelegate.setSoTimeout(previousTimeout);
+                } catch (IOException ignored) {
+                }
+            }
+        } else {
+            mDelegate.startHandshake();
+        }
+    }
+
+    @Override
+    public InputStream getInputStream() throws IOException {
+        return mDelegate.getInputStream();
+    }
+
+    @Override
+    public OutputStream getOutputStream() throws IOException {
+        return mDelegate.getOutputStream();
+    }
+
+    @Override
+    public SSLSession getSession() {
+        return mDelegate.getSession();
+    }
+
+    @Override
+    public SSLSession getHandshakeSession() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N || Build.VERSION.SDK_INT == 0) {
+            return mDelegate.getHandshakeSession();
+        }
+        return super.getHandshakeSession();
+    }
+
+    @RequiresApi(api = Build.VERSION_CODES.Q)
+    @Override
+    public String getApplicationProtocol() {
+        return mDelegate.getApplicationProtocol();
+    }
+
+    @RequiresApi(api = Build.VERSION_CODES.Q)
+    @Override
+    public String getHandshakeApplicationProtocol() {
+        return mDelegate.getHandshakeApplicationProtocol();
+    }
+
+    @Override
+    public String[] getSupportedCipherSuites() {
+        return mDelegate.getSupportedCipherSuites();
+    }
+
+    @Override
+    public String[] getEnabledCipherSuites() {
+        return mDelegate.getEnabledCipherSuites();
+    }
+
+    @Override
+    public void setEnabledCipherSuites(String[] suites) {
+        mDelegate.setEnabledCipherSuites(suites);
+    }
+
+    @Override
+    public String[] getSupportedProtocols() {
+        return mDelegate.getSupportedProtocols();
+    }
+
+    @Override
+    public String[] getEnabledProtocols() {
+        return mDelegate.getEnabledProtocols();
+    }
+
+    @Override
+    public void setEnabledProtocols(String[] protocols) {
+        mDelegate.setEnabledProtocols(protocols);
+    }
+
+    @Override
+    public void addHandshakeCompletedListener(HandshakeCompletedListener listener) {
+        mDelegate.addHandshakeCompletedListener(listener);
+    }
+
+    @Override
+    public void removeHandshakeCompletedListener(HandshakeCompletedListener listener) {
