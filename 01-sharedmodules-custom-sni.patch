@@ -0,0 +1,31 @@
+package com.liskovsoft.sharedutils.okhttp;
+
+import javax.net.ssl.HostnameVerifier;
+import javax.net.ssl.SSLSession;
+
+/**
+ * {@link HostnameVerifier} wrapper that validates the server certificate against either
+ * the original target hostname or its configured custom SNI from {@link CustomSniConfig}.
+ * Non-matching hosts are strictly verified against the original hostname.
+ */
+public class CustomSniHostnameVerifier implements HostnameVerifier {
+    private final HostnameVerifier mDelegate;
+
+    public CustomSniHostnameVerifier(HostnameVerifier delegate) {
+        mDelegate = delegate;
+    }
+
+    @Override
+    public boolean verify(String hostname, SSLSession session) {
+        if (mDelegate.verify(hostname, session)) {
+            return true;
+        }
+
+        String customSni = CustomSniConfig.getCustomSni(hostname);
+        if (customSni != null && !customSni.equalsIgnoreCase(hostname)) {
+            return mDelegate.verify(customSni, session);
+        }
+
+        return false;
+    }
+}
