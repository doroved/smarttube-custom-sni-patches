+package com.liskovsoft.sharedutils.okhttp;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.regex.Pattern;
+
+/**
+ * Host-to-SNI mapping configuration for establishing TLS connections with a custom SNI.
+ */
+public final class CustomSniConfig {
+    public static final String DEFAULT_CUSTOM_SNI = "www.google.com";
+    public static final int GOOGLEVIDEO_TLS_TIMEOUT_MS = 3_000;
+
+    private static final class WildcardRule {
+        final Pattern pattern;
+        final String sni;
+
+        WildcardRule(Pattern pattern, String sni) {
+            this.pattern = pattern;
+            this.sni = sni;
+        }
+    }
+
+    private static volatile boolean sEnabled = true;
+
+    private static final Map<String, String> EXACT_HOST_MAP;
+    private static final List<WildcardRule> WILDCARD_RULES;
+
+    static {
+        Map<String, String> exact = new HashMap<>();
+        List<WildcardRule> wildcards = new ArrayList<>();
+
+        // Youtube custom SNI host rules
+        addRule(exact, wildcards, "youtu.be", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "*.googlevideo.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "*.youtube.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "youtube.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "*.ytimg.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "*.ggpht.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "yt3.googleusercontent.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "lh*.googleusercontent.com", DEFAULT_CUSTOM_SNI);
+        addRule(exact, wildcards, "youtubei.googleapis.com", DEFAULT_CUSTOM_SNI);
+
+        EXACT_HOST_MAP = Collections.unmodifiableMap(exact);
+        WILDCARD_RULES = Collections.unmodifiableList(wildcards);
+    }
+
+    private CustomSniConfig() {
+    }
+
+    private static void addRule(Map<String, String> exact, List<WildcardRule> wildcards, String hostPattern, String sni) {
+        String normalized = normalizeHost(hostPattern);
+        if (normalized == null || normalized.isEmpty()) {
+            return;
+        }
+
+        if (normalized.contains("*")) {
+            wildcards.add(new WildcardRule(compileGlobPattern(normalized), sni));
+        } else {
+            exact.put(normalized, sni);
+        }
+    }
+
+    private static Pattern compileGlobPattern(@NonNull String glob) {
+        StringBuilder regex = new StringBuilder("^");
+        for (int i = 0; i < glob.length(); i++) {
+            char c = glob.charAt(i);
+            if (c == '*') {
+                // Leading "*." requires at least one character for the subdomain label
+                if (i == 0 && glob.length() > 1 && glob.charAt(1) == '.') {
+                    regex.append(".+");
+                } else {
+                    regex.append(".*");
+                }
+            } else if ("\\.[]{}()+-?^$|".indexOf(c) >= 0) {
+                regex.append('\\').append(c);
+            } else {
+                regex.append(c);
+            }
+        }
+        regex.append('$');
+        return Pattern.compile(regex.toString());
+    }
+
+    @Nullable
+    private static String normalizeHost(@Nullable String host) {
+        if (host == null) {
+            return null;
+        }
+        String normalized = host.trim().toLowerCase(Locale.US);
+        while (normalized.endsWith(".")) {
+            normalized = normalized.substring(0, normalized.length() - 1);
+        }
+        return normalized;
+    }
+
+    public static boolean isEnabled() {
+        return sEnabled;
+    }
+
+    public static void setEnabled(boolean enabled) {
+        sEnabled = enabled;
+    }
+
+    /**
+     * Returns the custom SNI hostname to send in TLS ClientHello for the given target host,
+     * or {@code null} if the host should use its default SNI.
+     */
+    @Nullable
+    public static String getCustomSni(@Nullable String host) {
+        if (!sEnabled) {
+            return null;
+        }
+
+        String normalized = normalizeHost(host);
+        if (normalized == null || normalized.isEmpty()) {
+            return null;
+        }
+
+        String exactMatch = EXACT_HOST_MAP.get(normalized);
+        if (exactMatch != null) {
+            return exactMatch;
+        }
+
+        for (WildcardRule rule : WILDCARD_RULES) {
+            if (rule.pattern.matcher(normalized).matches()) {
+                return rule.sni;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * Returns a custom TLS handshake / connect timeout in milliseconds for the given host,
+     * or {@code 0} to keep the default timeout.
+     * For {@code *.googlevideo.com}, drops stalled TLS connections after 3 seconds so the
+     * player can quickly fail over to another media CDN host.
+     */
+    public static int getTlsHandshakeTimeoutMs(@Nullable String host) {
+        if (!sEnabled) {
+            return 0;
+        }
+
+        String normalized = normalizeHost(host);
+        if (normalized != null && normalized.endsWith(".googlevideo.com") && normalized.length() > ".googlevideo.com".length()) {
+            return GOOGLEVIDEO_TLS_TIMEOUT_MS;
+        }
+
+        return 0;
+    }
+}
