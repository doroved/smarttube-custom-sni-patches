+package com.liskovsoft.sharedutils.okhttp;
+
+import com.liskovsoft.sharedutils.mylogger.Log;
+
+import java.security.KeyStore;
+import java.util.Arrays;
+
+import javax.net.ssl.HostnameVerifier;
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.SSLContext;
+import javax.net.ssl.SSLSocketFactory;
+import javax.net.ssl.TrustManager;
+import javax.net.ssl.TrustManagerFactory;
+import javax.net.ssl.X509TrustManager;
+
+/**
+ * Helper for installing {@link CustomSniSSLSocketFactory} and {@link CustomSniHostnameVerifier}
+ * as the process-wide defaults for {@link HttpsURLConnection} (covering Glide and ExoPlayer
+ * DefaultHttpDataSource) and creating system-trusted factories for OkHttp.
+ */
+public final class CustomSniHelper {
+    private static final String TAG = CustomSniHelper.class.getSimpleName();
+
+    private CustomSniHelper() {
+    }
+
+    public static X509TrustManager getSystemTrustManager() throws Exception {
+        TrustManagerFactory trustManagerFactory = TrustManagerFactory.getInstance(
+                TrustManagerFactory.getDefaultAlgorithm());
+        trustManagerFactory.init((KeyStore) null);
+        TrustManager[] trustManagers = trustManagerFactory.getTrustManagers();
+        if (trustManagers.length != 1 || !(trustManagers[0] instanceof X509TrustManager)) {
+            throw new IllegalStateException("Unexpected default trust managers: " + Arrays.toString(trustManagers));
+        }
+        return (X509TrustManager) trustManagers[0];
+    }
+
+    public static SSLSocketFactory createSystemCustomSniSocketFactory(X509TrustManager trustManager) throws Exception {
+        SSLContext sslContext = SSLContext.getInstance("TLS");
+        sslContext.init(null, new TrustManager[]{trustManager}, null);
+        return new CustomSniSSLSocketFactory(sslContext.getSocketFactory());
+    }
+
+    /**
+     * Installs custom SNI socket factory and hostname verifier as defaults for
+     * {@link HttpsURLConnection}. Safe to call multiple times (avoids double-wrapping).
+     */
+    public static void installDefaultHttps() {
+        try {
+            SSLSocketFactory currentFactory = HttpsURLConnection.getDefaultSSLSocketFactory();
+            if (!(currentFactory instanceof CustomSniSSLSocketFactory)) {
+                X509TrustManager trustManager = getSystemTrustManager();
+                HttpsURLConnection.setDefaultSSLSocketFactory(createSystemCustomSniSocketFactory(trustManager));
+            }
+
+            HostnameVerifier currentVerifier = HttpsURLConnection.getDefaultHostnameVerifier();
+            if (!(currentVerifier instanceof CustomSniHostnameVerifier)) {
+                HttpsURLConnection.setDefaultHostnameVerifier(new CustomSniHostnameVerifier(currentVerifier));
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to install default HTTPS custom SNI: %s", e.getMessage());
+        }
+    }
+}
