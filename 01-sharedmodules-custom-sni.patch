+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+public class CustomSniTest {
+
+    @Test
+    public void testMatchingHostsReturnCustomSni() {
+        String expected = "www.google.com";
+
+        String[] matchingHosts = {
+                "youtu.be",
+                "YOUTU.BE",
+                "youtu.be.",
+                "rr1---sn-4g5ednsd.googlevideo.com",
+                "r1.sn-a5mlrn7z.c.googlevideo.com",
+                "www.youtube.com",
+                "m.youtube.com",
+                "music.youtube.com",
+                "youtube.com",
+                "i.ytimg.com",
+                "i9.ytimg.com",
+                "s.ytimg.com",
+                "yt3.ggpht.com",
+                "yt3.googleusercontent.com",
+                "lh3.googleusercontent.com",
+                "lh4.googleusercontent.com",
+                "lh5.googleusercontent.com",
+                "lh6.googleusercontent.com",
+                "youtubei.googleapis.com"
+        };
+
+        for (String host : matchingHosts) {
+            assertEquals("Expected custom SNI for " + host, expected, CustomSniConfig.getCustomSni(host));
+        }
+    }
+
+    @Test
+    public void testNonMatchingHostsReturnNull() {
+        String[] nonMatchingHosts = {
+                null,
+                "",
+                "   ",
+                "www.google.com",
+                "google.com",
+                "github.com",
+                "evilyoutube.com",
+                "evilgooglevideo.com",
+                "googlevideo.com",
+                "ytimg.com",
+                "ggpht.com",
+                "googleusercontent.com",
+                "yt4.googleusercontent.com",
+                "accounts.google.com",
+                "accounts.google.ru",
+                "play.google.com",
+                "youtube-nocookie.com",
+                "www.youtube-nocookie.com",
+                "youtube.googleapis.com",
+                "example.com"
+        };
+
+        for (String host : nonMatchingHosts) {
+            assertNull("Expected null custom SNI for " + host, CustomSniConfig.getCustomSni(host));
+        }
+    }
+
+    @Test
+    public void testCustomSniHostnameVerifier() {
+        HostnameVerifier googleCertOnly = (hostname, session) -> "www.google.com".equals(hostname);
+        CustomSniHostnameVerifier verifier = new CustomSniHostnameVerifier(googleCertOnly);
+
+        // Matching host accepted when server presents www.google.com cert
+        assertTrue(verifier.verify("www.youtube.com", null));
+        assertTrue(verifier.verify("rr1---sn-abc.googlevideo.com", null));
+        assertTrue(verifier.verify("lh3.googleusercontent.com", null));
+
+        // Non-matching host MUST be rejected even when server presents www.google.com cert
+        assertFalse(verifier.verify("example.com", null));
+        assertFalse(verifier.verify("github.com", null));
+
+        // Matching host accepted when server presents its own cert
+        HostnameVerifier youtubeCertOnly = (hostname, session) -> "www.youtube.com".equals(hostname);
+        CustomSniHostnameVerifier verifier2 = new CustomSniHostnameVerifier(youtubeCertOnly);
+        assertTrue(verifier2.verify("www.youtube.com", null));
+        assertFalse(verifier2.verify("rr1---sn-abc.googlevideo.com", null));
+    }
+
+    @Test
+    public void testCustomSniSSLSocketEnforcesSni() throws Exception {
+        SSLContext sslContext = SSLContext.getInstance("TLS");
+        sslContext.init(null, null, null);
+        SSLSocketFactory baseFactory = sslContext.getSocketFactory();
+        CustomSniSSLSocketFactory customFactory = new CustomSniSSLSocketFactory(baseFactory);
+
+        try (ServerSocket server = new ServerSocket(0, 5, InetAddress.getLoopbackAddress())) {
+            int port = server.getLocalPort();
+
+            // 1. Matching host: wrapped in CustomSniSSLSocket and resists SNI overwrite
+            try (Socket raw1 = new Socket(InetAddress.getLoopbackAddress(), port);
+                 Socket serverConn1 = server.accept();
+                 Socket wrapped = customFactory.createSocket(raw1, "www.youtube.com", 443, true)) {
+                assertTrue("Expected CustomSniSSLSocket for matching host", wrapped instanceof CustomSniSSLSocket);
+
+                SSLSocket sslSocket = (SSLSocket) wrapped;
+                // Simulate OkHttp / platform attempting to overwrite SNI with original host
+                SSLParameters overwriteParams = sslSocket.getSSLParameters();
+                overwriteParams.setServerNames(Collections.<SNIServerName>singletonList(new SNIHostName("www.youtube.com")));
+                sslSocket.setSSLParameters(overwriteParams);
+
+                List<SNIServerName> serverNames = sslSocket.getSSLParameters().getServerNames();
+                assertNotNull(serverNames);
+                assertEquals(1, serverNames.size());
+                assertEquals("www.google.com", ((SNIHostName) serverNames.get(0)).getAsciiName());
+
+                // Verify Java 9+ / Android 10+ ALPN getters delegate instead of throwing UnsupportedOperationException
+                sslSocket.getApplicationProtocol();
+                sslSocket.getHandshakeApplicationProtocol();
+
+                // Verify the actual TLS ClientHello sent on the wire carries SNI www.google.com
+                AtomicReference<byte[]> clientHelloBytes = new AtomicReference<>();
+                Thread reader = new Thread(() -> {
+                    try {
+                        serverConn1.setSoTimeout(2000);
+                        InputStream in = serverConn1.getInputStream();
+                        byte[] buf = new byte[4096];
+                        int n = in.read(buf);
+                        if (n > 0) {
+                            byte[] data = new byte[n];
+                            System.arraycopy(buf, 0, data, 0, n);
+                            clientHelloBytes.set(data);
+                        }
+                        serverConn1.close();
+                    } catch (IOException ignored) {
+                    }
+                });
+                reader.start();
+
+                sslSocket.setSoTimeout(2000);
+                try {
+                    sslSocket.startHandshake();
+                } catch (IOException expected) {
+                    // Server closes after reading ClientHello
+                }
+                reader.join(3000);
+
+                byte[] hello = clientHelloBytes.get();
+                assertNotNull("Expected TLS ClientHello bytes", hello);
+                String helloAscii = new String(hello, StandardCharsets.ISO_8859_1);
+                assertTrue("ClientHello must contain custom SNI www.google.com", helloAscii.contains("www.google.com"));
+                assertFalse("ClientHello must NOT contain original host www.youtube.com", helloAscii.contains("www.youtube.com"));
+            }
+
+            // 2. Non-matching host should NOT be wrapped in CustomSniSSLSocket
+            try (Socket raw2 = new Socket(InetAddress.getLoopbackAddress(), port);
+                 Socket serverConn2 = server.accept();
+                 Socket plainWrapped = customFactory.createSocket(raw2, "example.com", 443, true)) {
+                assertFalse("Expected unwrapped SSLSocket for non-matching host", plainWrapped instanceof CustomSniSSLSocket);
+            }
+        }
+    }
+
+    @Test
+    public void testGooglevideoTlsHandshakeTimeout() throws Exception {
+        assertEquals(3_000, CustomSniConfig.getTlsHandshakeTimeoutMs("rr1---sn-4g5ednsd.googlevideo.com"));
+        assertEquals(3_000, CustomSniConfig.getTlsHandshakeTimeoutMs("R2.SN-ABC.C.GOOGLEVIDEO.COM."));
+        assertEquals(0, CustomSniConfig.getTlsHandshakeTimeoutMs("googlevideo.com"));
+        assertEquals(0, CustomSniConfig.getTlsHandshakeTimeoutMs("www.youtube.com"));
+
+        SSLContext sslContext = SSLContext.getInstance("TLS");
+        sslContext.init(null, null, null);
+        CustomSniSSLSocketFactory customFactory = new CustomSniSSLSocketFactory(sslContext.getSocketFactory());
+
+        // Simulate a blackholed *.googlevideo.com server that accepts TCP but never responds to TLS ClientHello
+        try (ServerSocket blackholeServer = new ServerSocket(0, 5, InetAddress.getLoopbackAddress());
+             Socket raw = new Socket(InetAddress.getLoopbackAddress(), blackholeServer.getLocalPort());
+             Socket accepted = blackholeServer.accept();
+             SSLSocket sslSocket = (SSLSocket) customFactory.createSocket(raw, "rr1---sn-blocked.googlevideo.com", 443, true)) {
+            sslSocket.setSoTimeout(20_000);
+            long startMs = System.currentTimeMillis();
+            boolean timedOut = false;
+            try {
+                sslSocket.startHandshake();
+            } catch (SocketTimeoutException expected) {
+                timedOut = true;
+            }
+            long elapsedMs = System.currentTimeMillis() - startMs;
+
+            assertTrue("Expected SocketTimeoutException on stalled *.googlevideo.com TLS handshake", timedOut);
+            assertTrue("Expected handshake timeout around 3s, got " + elapsedMs + "ms", elapsedMs >= 2500 && elapsedMs < 5000);
+            assertEquals("Original socket timeout should be restored after handshake", 20_000, sslSocket.getSoTimeout());
+        }
+    }
+}
